# Backend API URL
VITE_API_URL=http://localhost:8080/api/v1

# Environment identifier (development | staging | production)
VITE_ENV=development

# Feature flags (comma-separated list of enabled features, '*' = all)
# Keys: signup, monetization, federation, analytics, operations
# In local dev (DEV mode), all features default to ON if unset.
# Set VITE_FEATURES=* to explicitly enable all, or list specific features.
# VITE_FEATURES=*

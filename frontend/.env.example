# Backend API URL
VITE_API_URL=http://localhost:8080/api/v1

# Admin Access Code — a curtain on the /login page, NOT a security control.
# Every VITE_ value is compiled into the public JavaScript bundle, so treat this as public.
# Real protection is server-side authentication and role checks.
# Dev: AOS3R26ADMINDev | Staging: AOS3R26StgADMIN
VITE_ADMIN_ACCESS_CODE=AOS3R26ADMINDev

# Environment identifier (development | staging | production)
VITE_ENV=development
